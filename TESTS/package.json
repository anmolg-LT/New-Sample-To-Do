{
  "name": "sample-to-do-tests",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "playwright test --project=chromium",
    "test:headed": "playwright test --project=chromium --headed --workers=1",
    "test:ui": "playwright test --project=chromium --ui",
    "test:debug": "playwright test --project=chromium --debug",
    "test:lt": "playwright test --project='chrome:latest:Windows 11@lambdatest'",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "~1.55.0"
  },
  "dependencies": {
    "@lambdatest/playwright-driver": "^1.0.7",
    "@lambdatest/smartui-cli": "^4.1.70",
    "playwright": "^1.60.0"
  }
}
